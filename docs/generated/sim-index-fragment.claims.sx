  (primary [row Route(RouteRecord { id: RouteId("route/add-guest-language-profile"), title: "Add a guest language profile", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/guest-language-profiles"), why: "The profile row establishes the checked thin-profile ownership boundary before any guest-specific work and points to Lua as the no-compiler reference." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-standard-core/src/tests"), why: "The shared profile specimen fails closed unless reader, lowering, eval policy, organ reuse, capabilities, and gaps are explicit." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-lua/src/conformance"), why: "The Lua source-codec specimen proves direct source parsing and lowering through the positive reference profile." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-lua/src/lib"), why: "The Lua profile and matrix-row tests are the final shared-matrix registration specimen for a guest profile." }], doc_anchor: None })] [note "route/add-guest-language-profile"] [section "route"])
