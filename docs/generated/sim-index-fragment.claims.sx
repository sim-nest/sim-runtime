  (primary [row Route(RouteRecord { id: RouteId("route/supply-guest-host-services"), title: "Supply explicit host services to a guest runtime", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/guest-host-service-boundary"), why: "The boundary keeps source, import, process, class-loading, and runtime configuration explicit and fail-closed." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-exec/src/tests"), why: "The execution specimen proves that process effects cross the structured caller-supplied ProcessPort boundary." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-lua/src/conformance"), why: "The Lua conformance specimen exercises supplied runtime configuration without ambient host inspection." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-python/src/lib"), why: "The Python specimen exercises source and module access through explicit SourceAuthority and roots." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/product_specimen"), why: "The JVM product specimen loads authorized class bytes through the checked loader surface." }], doc_anchor: None })] [note "route/supply-guest-host-services"] [section "route"])
