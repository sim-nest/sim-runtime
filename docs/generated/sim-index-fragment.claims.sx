  (primary [row Route(RouteRecord { id: RouteId("route/add-dataflow-analysis"), title: "Add a proof-producing dataflow analysis", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/incremental-query-core"), why: "The core owns the one generic worklist, lattice admission, widening, continuations, explanations, incremental reuse, and completion proofs; callers contribute only domain transfer rules." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-incremental-core/tests/definite_assignment_specimen"), why: "The forward definite-assignment specimen covers branches, loops, unreachable code, exceptional edges, diagnostics, and exact incremental invalidation." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-incremental-core/tests/range_analysis_specimen"), why: "The backward range specimen proves explicit fingerprinted widening, typed budget exhaustion, resumability, explanations, and deterministic proof identity." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-incremental-core/tests/ownership_guard"), why: "The structural guard rejects a second memoized worklist while explicitly classifying domain transfer rules and unrelated algorithms." }], doc_anchor: None })] [note "route/add-dataflow-analysis"] [section "route"])
