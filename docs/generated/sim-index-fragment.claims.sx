  (primary [row Route(RouteRecord { id: RouteId("route/add-runtime-organ"), title: "Add a runtime organ", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/organs"), why: "The organ row groups reusable binding, control, logic, pattern, incremental, mutation, namespace, and sequence behavior." }, Feature { id: FeatureId("feature/sim-runtime/binding-organ"), why: "The binding row owns lexical cells and binding mechanics shared by guest profiles." }, Feature { id: FeatureId("feature/sim-runtime/function-organ"), why: "The function row owns typed managed instances and collector-visible capture composition." }, Feature { id: FeatureId("feature/sim-runtime/control-organ"), why: "The control row owns resumable frames and control transfer shared by guest profiles." }, Feature { id: FeatureId("feature/sim-runtime/property-mechanics"), why: "The property row owns descriptor dispatch and reusable property semantics." }, Feature { id: FeatureId("feature/sim-runtime/namespace-organ"), why: "The namespace row owns bounded module resolution and caller-supplied source roots." }, Feature { id: FeatureId("feature/sim-runtime/contract-emitter"), why: "The emitter row keeps generated runtime contract evidence current." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-function/01-basics/neutral-language"), why: "The terminal checked specimen composes typed lexical capture, positional and named inputs, browsing, managed-cycle collection, and optional generic dispatch without importing an established guest runtime." }], doc_anchor: None })] [note "route/add-runtime-organ"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/admit-dynamic-source"), title: "Admit dynamic guest source without copying authority", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/capabilities-read-eval"), why: "The core owner keeps trusted read policy, required caller powers, and diminished allowed powers in one host-built SourceAuthority." }, Feature { id: FeatureId("feature/sim-sdk/source-authority-facade"), why: "The SDK presents the canonical authority, request, broker, and dynamic-policy builders directly without a facade envelope." }, Specimen { id: SpecimenId("recipe/sim-sdk/source-authority/dynamic-text"), why: "The public Rust recipe constructs authority through the SDK and proves admitted and missing-caller-power outcomes through the shared broker." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-core/src/source_authority_ownership_tests"), why: "The source-fact guard permits guest semantic wrappers, rejects repeated authority fields and generic admission types, and classifies unwired guests without adding behavior." }], doc_anchor: None })] [note "route/admit-dynamic-source"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/characterize-a-refactor"), title: "Capture behavior before a refactor and compare it afterward", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/characterization-captures"), why: "Standard core owns bounded canonical captures, content identity, strict two-sided comparison, and located differences." }, Feature { id: FeatureId("feature/sim-sdk/characterization-facade"), why: "The SDK presents the public migration types without exposing standard-core internals." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-standard-core/01-basics/characterize-migration"), why: "The public recipe states the capture-before, refactor, capture-after, strict-compare contract." }, Specimen { id: SpecimenId("spec-test/sim-sdk/tests/characterization"), why: "The downstream test proves identical captures and a located mismatch through SDK-visible types." }], doc_anchor: None })] [note "route/characterize-a-refactor"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/collect-language-neutral-managed-graph"), title: "Collect a language-neutral managed graph", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/mutation-organ"), why: "The mutation row supplies allocation-deterministic managed ids, graph storage, roots, weak edges, ephemerons, and safepoints without selecting a guest language." }, Feature { id: FeatureId("feature/sim-runtime/gc-tracing"), why: "The collector row supplies bounded synchronous tracing, atomic sweep, weak clearing, and isolated finalization admission without claiming language behavior." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-gc-tracing/src/tests"), why: "The checked non-language managed-graph specimen compares generated graphs and safepoint schedules with a model tracer and proves wasm-closure collection." }], doc_anchor: None })] [note "route/collect-language-neutral-managed-graph"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/compare-cross-language-callables"), title: "Compare Python, JavaScript, and Lua callable and object-model semantics", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/function-organ"), why: "The function organ supplies the neutral kernel Callable projection and browse Shapes shared by all three guests." }, Feature { id: FeatureId("feature/sim-runtime/class-semantics"), why: "The class organ owns declared-parent lineage while explicitly excluding prototype and __index delegation." }, Feature { id: FeatureId("feature/sim-runtime/python-object-control-policy"), why: "Python projects its declared superclass graph through the class protocol." }, Feature { id: FeatureId("feature/sim-runtime/javascript-core-profile"), why: "JavaScript retains prototype lookup as guest object policy rather than declared lineage." }, Feature { id: FeatureId("feature/sim-runtime/guest-language-profiles"), why: "Lua retains metatable __index lookup as guest policy rather than declared lineage." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-lang-matrix/01-basics/cross-language-callable"), why: "The terminal checked recipe browses and calls all three functions, compares canonical outcomes, and proves that only Python answers the declared-parent query." }], doc_anchor: None })] [note "route/compare-cross-language-callables"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/explain-semantic-world-change"), title: "Project supplied world facts and explain their exact affected closure", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/incremental-query-core"), why: "The core owns open provider admission, immutable selected inputs, semantic digests, federated owner graphs, and exact explanations." }, Feature { id: FeatureId("feature/sim-runtime/world-projection-product"), why: "The loaded world product exposes project, diff, why, compose, plan, projection sensitivity, explicit domain-port snapshots, and an offline source seal, refuses an unsupported pair or a malformed call, reports read-only custody, and answers resident cached why, plan, and seal without ambient observation or mutation authority." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-world/01-projection/world-explain"), why: "The checked recipe reaches the stable loaded operations over caller-supplied facts." }], doc_anchor: None })] [note "route/explain-semantic-world-change"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/guard-an-operation"), title: "Guard and replay a capability-scoped operation", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/guarded-operations"), why: "The generic gate owns explicit policy, exact approval, atomic use, records, and the performer boundary." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-operation-gate/01-basics/two-manifests"), why: "Two unrelated fixture manifests prove the gate contains no automotive assumption." }], doc_anchor: None })] [note "route/guard-an-operation"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/inspect-jvm-performance-evidence"), title: "Inspect JVM prepared-execution performance evidence", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/jvm-loadable-profile"), why: "The JVM profile publishes prepared-code, verified micro-op, and generated fusion coverage without owning benchmark statistics." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-lang-jvm/01-basics/performance-evidence"), why: "The recipe maps every fidelity and performance claim to generated coverage and canonical benchmark harness raw samples." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/published_performance"), why: "The checked publication fixture keeps raw report identities, summaries, generated coverage, and ownership guards connected." }], doc_anchor: None })] [note "route/inspect-jvm-performance-evidence"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/link-jvm-lambda"), title: "Link and invoke a JVM lambda or method reference", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/jvm-loadable-profile"), why: "The JVM profile owns bootstrap admission, direct-handle resolution, loader-local generated metadata, and Java descriptor adaptation." }, Feature { id: FeatureId("feature/sim-runtime/function-organ"), why: "The shared function organ owns the neutral Callable projection and collector-visible captures used at the SIM boundary." }, Feature { id: FeatureId("feature/sim-runtime/class-semantics"), why: "The shared class organ owns language-neutral class structure; defining-loader identity remains JVM policy." }, Feature { id: FeatureId("feature/sim-runtime/mutation-organ"), why: "The managed graph owns lambda instances, captures, weak identities, and collection rather than a JVM-private graph or global cache." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/verifier_scope"), why: "The verifier consumes the executor-owned admitted bootstrap registry and seals exact whole-class proof before preparation." }, Specimen { id: SpecimenId("recipe/sim-runtime/crates/sim-lib-lang-jvm/01-basics/java-lambda"), why: "The published Java-to-SIM recipe links compiler-produced bytes and invokes the result through ordinary Callable." }, Specimen { id: SpecimenId("recipe/sim-sdk/jvm/lambda-interop"), why: "The SDK recipe reaches both interop directions through public facade exports only." }], doc_anchor: None })] [note "route/link-jvm-lambda"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/load-runtime-library"), title: "Load a runtime library", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/library-loading"), why: "The loading row owns standard and language-profile runtime libraries." }], doc_anchor: None })] [note "route/load-runtime-library"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/lower-javascript-regexp"), title: "Lower bounded JavaScript RegExp syntax into the shared pattern organ", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/javascript-core-profile"), why: "The bounded JavaScript profile owns ECMAScript admission, exclusions, and UTF-16 syntax policy." }, Feature { id: FeatureId("feature/sim-runtime/pattern-cursor-domains"), why: "Admitted RegExp syntax lowers to the shared automaton and executes with exact code-unit offsets and bounded receipts." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-javascript/src/regexp"), why: "The JavaScript specimen checks the real RegExp adapter, exact UTF-16 captures, work limits, and fail-closed unsupported clauses." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-pattern/tests/cross_dialect_safety"), why: "The organ specimen independently demonstrates exact byte, scalar, and code-unit domains plus bounded adversarial ambiguity." }], doc_anchor: None })] [note "route/lower-javascript-regexp"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/lower-lua-pattern"), title: "Lower Lua pattern syntax into the shared pattern organ", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/guest-language-profiles"), why: "Lua retains its surface syntax and character-class policy while composing runtime organs." }, Feature { id: FeatureId("feature/sim-runtime/pattern-cursor-domains"), why: "The shared pattern organ validates the lowering and executes it with typed scalar offsets and bounded receipts." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-pattern/tests/cross_dialect_safety"), why: "The runnable cross-dialect specimen lowers Lua syntax beside glob and neutral IR, then executes all three through the same organ." }], doc_anchor: None })] [note "route/lower-lua-pattern"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/lower-shell-glob"), title: "Lower shell glob syntax into the shared pattern organ", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/pattern-cursor-domains"), why: "The glob adapter lowers its anchored surface into the shared validated IR and bounded scalar-domain executor." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-pattern/tests/cross_dialect_safety"), why: "The runnable specimen proves glob syntax reaches the same organ as Lua and neutral IR without copying an executor." }], doc_anchor: None })] [note "route/lower-shell-glob"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/match-exact-code-unit-text"), title: "Match exact UTF-16 text without losing code-unit positions", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-foundation/exact-code-unit-text"), why: "The sim-text value preserves paired and lone surrogate units and owns checked conversion between scalar and code-unit offsets." }, Feature { id: FeatureId("feature/sim-runtime/pattern-cursor-domains"), why: "The pattern organ executes directly over exact units and returns domain-typed match and capture offsets." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-pattern/tests/cursor_domains"), why: "The checked specimen matches a lone surrogate and stops between a surrogate pair's halves without admitting that position as a scalar offset." }], doc_anchor: None })] [note "route/match-exact-code-unit-text"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/perform-durable-operation"), title: "Persist, reconcile, and safely hand off one durable operation", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/guarded-operations"), why: "OperationLifecycle derives canonical intent identity, records bounded fenced leases and performer-bound dispatch, and observes independently before recovery." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-operation-gate/src/lifecycle_tests"), why: "Hostile fake ports cross every lifecycle boundary, lose acknowledgements and receipts, dispute observations, expire leases, and prove ExactlyOnce never redispatches." }], doc_anchor: None })] [note "route/perform-durable-operation"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/run-authorized-jvm"), title: "Run authorized JVM classfile bytes", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-runtime/jvm-loadable-profile"), why: "The runtime row owns bounded JVM semantics while reusing the shared classfile decoder, machine, managed graph, exceptions, and source authority." }, Feature { id: FeatureId("feature/sim-runtime/machine-contract"), why: "The shared machine owns slots, frames, iterative drive, and safepoint publication." }, Feature { id: FeatureId("feature/sim-runtime/gc-tracing"), why: "The managed and tracing organs own object identity, graph edges, roots, and bounded collection." }, Feature { id: FeatureId("feature/sim-runtime/class-semantics"), why: "The class organ owns language-neutral declared-class structure while JVM loader identity remains JVM policy." }, Feature { id: FeatureId("feature/sim-runtime/capabilities-read-eval"), why: "The source-authority organ keeps class loading explicit and diminished rather than ambient." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/product_specimen"), why: "The public specimen executes static, managed-object, array, guest-exception, and exact-concat cases." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/ownership_guard"), why: "Policy fixtures reject every prohibited ownership fork and scan the production JVM sources." }, Specimen { id: SpecimenId("spec-test/sim-runtime/crates/sim-lib-lang-jvm/tests/baseline"), why: "Generated opcode and intrinsic coverage totals differ from their manifests by zero." }], doc_anchor: None })] [note "route/run-authorized-jvm"] [section "route"])
